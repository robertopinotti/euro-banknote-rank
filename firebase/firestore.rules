rules_version = '2';

// ============================================================================
//  Firestore security rules for the banknote ranking.
//
//  Cloud Functions are not available on the free plan, so the browser writes
//  to Firestore directly and these rules are the only defence. They are
//  written to guarantee one thing, but to guarantee it well: a vote can only
//  add 1 to one counter. You cannot write an arbitrary score, you cannot touch
//  a second counter in the same write, and you cannot delete anything.
//
//  All 540 counters live in a single document, stats/all. They used to be 270
//  separate documents, one per pair, which cost 270 reads every time somebody
//  opened the site — 50,000 free reads a day divided by 270 is 185 visits, and
//  the ranking really did go dark when that ran out. One document is one read.
//
//  The price is that the rules can no longer name the field being changed:
//  with one document per pair, "winsLo" was written into the rule. Here the
//  write says which counter it is touching, in the `last` field, and the rules
//  check that claim against the data. Dynamic indexing — c[last] — is what
//  makes that possible, and it is verified by the tests, not assumed.
//
//  What the rules still CANNOT do is stop a script from sending many
//  legitimate +1 votes. That needs App Check (see the README): the rules
//  defend the value of the data, App Check defends where it comes from.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // A counter name: denomination, the two designs in alphabetical order, and
    // which of the two won. The 45 pairs are spelled out rather than matched
    // with [a-j]_[a-j], because that shorter pattern would also accept "c_a"
    // and "a_a" — a reversed or self-paired counter would be read back as a
    // real result and would quietly distort the ranking.
    function isCounterName(k) {
      return k is string
          && k.matches('^d(5|10|20|50|100|200)_(a_b|a_c|a_d|a_e|a_f|a_g|a_h|a_i|a_j|b_c|b_d|b_e|b_f|b_g|b_h|b_i|b_j|c_d|c_e|c_f|c_g|c_h|c_i|c_j|d_e|d_f|d_g|d_h|d_i|d_j|e_f|e_g|e_h|e_i|e_j|f_g|f_h|f_i|f_j|g_h|g_i|g_j|h_i|h_j|i_j)_(lo|hi)$');
    }

    match /stats/all {

      // The ranking is public.
      allow read: if true;

      // The document is seeded once, by hand, and then only ever incremented.
      // Nothing legitimate creates it, so nothing is allowed to: a create rule
      // here would be a way to overwrite the whole ranking with one write.
      allow create: if false;

      allow update: if
        // Only these two fields exist, and only these two may change.
           request.resource.data.keys().hasOnly(['c', 'last'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['c', 'last'])

        // The write has to name the counter it is touching, and the name has
        // to be one of the 540 real ones.
        && isCounterName(request.resource.data.last)

        // ...and that name has to be the truth: exactly one counter changed,
        // and it is the one named. Without this, a write could declare a
        // harmless counter and inflate a different one in the same operation.
        && request.resource.data.c.diff(resource.data.c)
             .affectedKeys().hasOnly([request.resource.data.last])

        // One vote is one vote. Reading the old value through the same key
        // also means a counter that does not already exist cannot be created:
        // the comparison has nothing to read and the rule fails.
        && request.resource.data.c[request.resource.data.last]
             == resource.data.c[request.resource.data.last] + 1;

      // Votes are never deleted.
      allow delete: if false;
    }

    // The old per-pair collection. Kept readable so a browser still running
    // the previous version from its cache is not broken; writes are closed,
    // because the counts that matter now live in stats/all. It can be deleted
    // once the old caches have expired.
    match /pairStats/{pairId} {
      allow read: if true;
      allow write: if false;
    }

    // Everything else is closed: if a collection is added one day, that has to
    // be an explicit choice and not a hole left open.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
