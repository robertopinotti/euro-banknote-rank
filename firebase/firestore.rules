rules_version = '2';

// ============================================================================
//  Firestore security rules for the banknote ranking.
//
//  Cloud Functions are not available on the free plan, so the browser writes
//  to Firestore directly and these rules are the only defence. They are
//  written to guarantee one thing, but to guarantee it well: a vote can only
//  add 1 to one counter. You cannot write an arbitrary score, you cannot touch
//  the other counter, you cannot delete anything, and you cannot create a
//  document that does not correspond to a valid pair.
//
//  What the rules CANNOT do is stop a script from sending many legitimate +1
//  votes. That needs App Check (see the README): the rules defend the value of
//  the data, App Check defends where it comes from.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isDenomination(value) {
      return value is int && value in [5, 10, 20, 50, 100, 200];
    }

    function isDesign(value) {
      return value is string && value.matches('^[a-j]$');
    }

    // The three identity fields must be consistent with each other and with
    // the document id, so a pair has exactly one row and spurious documents
    // cannot be created.
    function hasValidIdentity(pairId, data) {
      return isDenomination(data.denomination)
          && isDesign(data.designLo)
          && isDesign(data.designHi)
          && data.designLo < data.designHi
          && pairId == string(data.denomination) + '_' + data.designLo + '_' + data.designHi;
    }

    // Exactly these five fields, no more and no fewer. Both checks are needed:
    // hasOnly means "subset of", so on its own it would let through a document
    // missing a counter. Such a document would be rejected anyway — the later
    // checks would read a non-existent field and evaluation would fail — but
    // as a side effect of the rules engine, not by choice. hasAll does not
    // close a hole; it makes explicit something that was only implicit.
    function hasExactShape(data) {
      return data.keys().hasAll(['denomination', 'designLo', 'designHi', 'winsLo', 'winsHi'])
          && data.keys().hasOnly(['denomination', 'designLo', 'designHi', 'winsLo', 'winsHi']);
    }

    function counters(data) {
      return data.winsLo is int && data.winsHi is int
          && data.winsLo >= 0 && data.winsHi >= 0;
    }

    match /pairStats/{pairId} {

      // The ranking is public.
      allow read: if true;

      // First vote for this pair: the document is born, with exactly one vote
      // in total. No fields beyond the five expected ones.
      allow create: if hasExactShape(request.resource.data)
                    && hasValidIdentity(pairId, request.resource.data)
                    && counters(request.resource.data)
                    && request.resource.data.winsLo + request.resource.data.winsHi == 1;

      // Later votes: only one of the two counters may change, and only by +1.
      // The identity fields must stay as they were.
      allow update: if hasExactShape(request.resource.data)
                    && hasValidIdentity(pairId, request.resource.data)
                    && counters(request.resource.data)
                    && request.resource.data.denomination == resource.data.denomination
                    && request.resource.data.designLo == resource.data.designLo
                    && request.resource.data.designHi == resource.data.designHi
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['winsLo', 'winsHi'])
                    && (
                         (request.resource.data.winsLo == resource.data.winsLo + 1
                          && request.resource.data.winsHi == resource.data.winsHi)
                         ||
                         (request.resource.data.winsHi == resource.data.winsHi + 1
                          && request.resource.data.winsLo == resource.data.winsLo)
                       );

      // Votes are never deleted.
      allow delete: if false;
    }

    // Everything else is closed: if a collection is added one day, that has to
    // be an explicit choice and not a hole left open.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
